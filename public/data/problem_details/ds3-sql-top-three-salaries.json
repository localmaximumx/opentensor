  "requirements": [
    "Rank salaries within each department using DENSE_RANK; order results by department, salary descending, then employee_id."
  ],
  "hints": [
    "Write the base aggregation/deduplication CTE first.",
    "Use a window function or grouped date arithmetic to identify ranks/streaks.",
    "Check tie and missing-prior-period behavior."
  ],
  "constraints": [
    "SQL dialect: PostgreSQL unless a platform-specific adaptation is required.",
