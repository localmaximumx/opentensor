  "starterCode": "import numpy as np\n\ndef adam_step(\n    param: list,\n    grad: list,\n    m: list,\n    v: list,\n    t: int,\n    lr: float = 1e-3,\n    beta1: float = 0.9,\n    beta2: float = 0.999,\n    eps: float = 1e-8,\n) -> tuple[np.ndarray, np.ndarray, np.ndarray]:\n    \"\"\"\n    Returns (param_new, m_new, v_new) as NumPy arrays.\n    \"\"\"\n    # Write code here\n    pass",
